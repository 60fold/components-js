{
  "name": "@sixtyfold/mcp",
  "version": "1.0.0",
  "description": "Local Model Context Protocol server for version-aware Sixtyfold component guidance.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "author": "Different Planet - Unipessoal Lda.",
  "type": "module",
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "sideEffects": false,
  "bin": {
    "sixtyfold-mcp": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./catalog": {
      "types": "./dist/catalog.d.ts",
      "import": "./dist/catalog.js",
      "default": "./dist/catalog.js"
    },
    "./package.json": "./package.json",
    "./capabilities.json": "./capabilities.json"
  },
  "files": [
    "dist",
    "knowledge",
    "capabilities.json",
    "LICENSE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/60fold/components-js.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://sixtyfold.dev/en/docs/mcp",
  "bugs": {
    "url": "https://github.com/60fold/components-js/issues"
  },
  "keywords": [
    "sixtyfold",
    "mcp",
    "model-context-protocol",
    "charts",
    "developer-tools",
    "typescript"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "zod": "4.4.3"
  },
  "scripts": {
    "build": "node ../../scripts/clean-package-dist.mjs && tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.build.json --noEmit"
  }
}
