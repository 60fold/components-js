{
  "name": "@sixtyfold/vue",
  "version": "1.0.0",
  "description": "Vue adapters for Sixtyfold line and stock charts.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "author": "Different Planet - Unipessoal Lda.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./line": {
      "types": "./dist/line.d.ts",
      "import": "./dist/line.js",
      "default": "./dist/line.js"
    },
    "./stock": {
      "types": "./dist/stock.d.ts",
      "import": "./dist/stock.js",
      "default": "./dist/stock.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/60fold/components-js.git",
    "directory": "packages/vue"
  },
  "homepage": "https://sixtyfold.dev/en/docs/frameworks#vue",
  "bugs": {
    "url": "https://github.com/60fold/components-js/issues"
  },
  "keywords": [
    "sixtyfold",
    "charts",
    "vue",
    "canvas2d",
    "visualization"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "@sixtyfold/core": "workspace:^",
    "@sixtyfold/line": "workspace:^",
    "@sixtyfold/stock": "workspace:^",
    "vue": ">=3.4.0 <4.0.0"
  },
  "peerDependenciesMeta": {
    "@sixtyfold/core": {
      "optional": true
    },
    "@sixtyfold/line": {
      "optional": true
    },
    "@sixtyfold/stock": {
      "optional": true
    }
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.types.json",
    "dev": "vite build --watch --emptyOutDir=false",
    "typecheck": "tsc -p tsconfig.types.json --noEmit"
  }
}
